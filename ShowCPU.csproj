<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ShowCPU.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPF reads DPI awareness only from app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>ShowCPU</AssemblyName>
    <RootNamespace>ShowCPU</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>ShowCPU</Product>
    <Company>ShowCPU</Company>
    <Description>Taskbar widget that shows CPU usage for the last 15 seconds.</Description>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);log/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\ShowCPU.ico" />
    <Resource Include="Assets\ShowCPU.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="log\**" />
    <Page Remove="log\**" />
    <ApplicationDefinition Remove="log\**" />
    <None Remove="log\**" />
    <Content Remove="log\**" />
    <EmbeddedResource Remove="log\**" />
  </ItemGroup>
</Project>
