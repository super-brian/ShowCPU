<Window x:Class="ShowCPU.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShowCPU"
        Title="ShowCPU"
        Width="122"
        Height="52"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Cursor="SizeAll"
        Focusable="True"
        IsTabStop="False"
        Background="#141414"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="Pill"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="4"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#262626" Offset="0"/>
                <GradientStop Color="#141414" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="3,1,5,1">
            <Grid.ColumnDefinitions>
                <!-- Tight fixed left pane: label + one space + 4-char value. -->
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CpuLabel"
                           Grid.Row="0" Grid.Column="0"
                           Text="CPU"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="10"
                           Foreground="#FFD60A"
                           VerticalAlignment="Center"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="PercentText"
                           Grid.Row="0" Grid.Column="2"
                           Text="  --"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#FFD60A"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextAlignment="Left"
                           TextWrapping="NoWrap"/>
                <TextBlock x:Name="ClockLabel"
                           Grid.Row="1" Grid.Column="0"
                           Text="CLK"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="10"
                           Foreground="#6ECBFF"
                           VerticalAlignment="Center"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="ClockText"
                           Grid.Row="1" Grid.Column="2"
                           Text="  --"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#6ECBFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextAlignment="Left"
                           TextWrapping="NoWrap"/>
                <TextBlock x:Name="PowerLabel"
                           Grid.Row="2" Grid.Column="0"
                           Text="PWR"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="10"
                           Foreground="#FF9500"
                           VerticalAlignment="Center"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="PowerText"
                           Grid.Row="2" Grid.Column="2"
                           Text="  --"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#FF9500"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextAlignment="Left"
                           TextWrapping="NoWrap"/>
            </Grid>
            <local:CpuGraph x:Name="Graph" Grid.Column="2" Margin="0,0,2,0"/>
        </Grid>
    </Border>
</Window>
